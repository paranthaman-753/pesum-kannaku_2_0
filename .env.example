# Copy this file to ".env" in the project root and fill in the values.
# The ".env" file is ignored by git. Never commit real keys.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pesum_kanakku

# Get a key from https://aistudio.google.com/ (used by the backend only)
GEMINI_API_KEY=

# Model name is deliberately not hard-coded. Use any Gemini model your key can access.
# Example: gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# Optional tuning (leave empty to use defaults)
# How long the app waits for Gemini before giving up, in milliseconds (default 30000)
GEMINI_TIMEOUT_MS=
# Set to 0 to switch off "thinking" on Gemini Flash models for faster replies.
# Leave empty if your model does not support this setting.
GEMINI_THINKING_BUDGET=
